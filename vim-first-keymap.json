{
  "version": 1,
  "source": "lingfeng-xiao/nvim-config NvChad habits plus the user's Cursor Vim-first requirements",
  "leader": "<Space>",
  "bindings": [
    {"keys": "gd", "label": "Go to Definition", "group": "LSP", "nvim": "vim.lsp.buf.definition", "cursor": "editor.action.revealDefinition"},
    {"keys": "gD", "label": "Go to Declaration", "group": "LSP", "nvim": "vim.lsp.buf.declaration", "cursor": "editor.action.revealDeclaration"},
    {"keys": "gr", "label": "Find References", "group": "LSP", "nvim": "vim.lsp.buf.references", "cursor": "editor.action.goToReferences"},
    {"keys": "gi", "label": "Go to Implementation", "group": "LSP", "nvim": "vim.lsp.buf.implementation", "cursor": "editor.action.goToImplementation"},
    {"keys": "K", "label": "Hover Documentation", "group": "LSP", "nvim": "vim.lsp.buf.hover", "cursor": "editor.action.showHover"},
    {"keys": "[d", "label": "Previous Diagnostic", "group": "Diagnostics", "nvim": "vim.diagnostic.jump-prev", "cursor": "editor.action.marker.prev"},
    {"keys": "]d", "label": "Next Diagnostic", "group": "Diagnostics", "nvim": "vim.diagnostic.jump-next", "cursor": "editor.action.marker.next"},
    {"keys": "<leader>ca", "label": "Code Action", "group": "Code", "nvim": "vim.lsp.buf.code_action", "cursor": "editor.action.quickFix", "visual": true},
    {"keys": "<leader>rn", "label": "Rename Symbol", "group": "Rename", "nvim": "vim.lsp.buf.rename", "cursor": "editor.action.rename"},
    {"keys": "<leader>ff", "label": "Find File", "group": "Files", "nvim": "Telescope find_files", "cursor": "workbench.action.quickOpen"},
    {"keys": "<leader>fg", "label": "Search Text in Workspace", "group": "Files", "nvim": "Telescope live_grep", "cursor": "workbench.action.quickTextSearch"},
    {"keys": "<leader>fs", "label": "Find Workspace Symbol", "group": "Files", "nvim": "Telescope lsp_dynamic_workspace_symbols", "cursor": "workbench.action.showAllSymbols"},
    {"keys": "<leader>fb", "label": "Open Buffer", "group": "Files", "nvim": "Telescope buffers", "cursor": "workbench.action.showAllEditors"},
    {"keys": "<leader>e", "label": "Explorer / Editor", "group": "Explorer", "nvim": "vim-first.explorer-toggle-focus", "cursor": "workbench.view.explorer"},
    {"keys": "<leader>bd", "label": "Close Buffer", "group": "Buffers", "nvim": "bdelete", "cursor": "workbench.action.closeActiveEditor"},
    {"keys": "<C-h>", "label": "Focus Left", "group": "Windows", "nvim": "vim-first.window-left", "cursor": "workbench.action.navigateLeft", "cursor_binding": "normal-and-explorer"},
    {"keys": "<C-j>", "label": "Focus Down", "group": "Windows", "nvim": "vim-first.window-down", "cursor": "workbench.action.navigateDown", "cursor_binding": "normal-and-explorer"},
    {"keys": "<C-k>", "label": "Focus Up", "group": "Windows", "nvim": "vim-first.window-up", "cursor": "workbench.action.navigateUp", "cursor_binding": "normal-and-explorer"},
    {"keys": "<C-l>", "label": "Focus Right", "group": "Windows", "nvim": "vim-first.window-right", "cursor": "workbench.action.navigateRight", "cursor_binding": "normal-and-explorer"},
    {"keys": "<leader>wv", "label": "Vertical Split", "group": "Windows", "nvim": "vim-first.window-vsplit", "cursor": "workbench.action.splitEditorRight"},
    {"keys": "<leader>ws", "label": "Horizontal Split", "group": "Windows", "nvim": "vim-first.window-split", "cursor": "workbench.action.splitEditorDown"},
    {"keys": "<leader>t", "label": "Toggle Terminal", "group": "Terminal", "nvim": "vim-first.terminal-toggle", "cursor": "workbench.action.terminal.toggleTerminal"},
    {"keys": "<leader>ch", "label": "Cheatsheet", "group": "Help", "nvim": "vim-first.cheatsheet", "cursor": "vim-first.cheatsheet-preview"},
    {"keys": "<leader>aa", "label": "Focus Agent", "group": "AI", "nvim": null, "cursor": "composer.focusComposer"},
    {"keys": "<leader>ai", "label": "Inline Edit", "group": "AI", "nvim": null, "cursor": "aipopup.action.modal.generate", "visual": true},
    {"keys": "<leader>an", "label": "New Chat", "group": "AI", "nvim": null, "cursor": "composer.createNewComposerTab"},
    {"keys": "<leader>ap", "label": "Plan Mode", "group": "AI", "nvim": null, "cursor": "composerMode.plan"},
    {"keys": "<leader>ac", "label": "Add Selection to Current Chat", "group": "AI", "nvim": null, "cursor": "aichat.newfollowupaction", "visual_only": true},
    {"keys": "<leader>ar", "label": "Review Inline Changes", "group": "AI", "nvim": null, "cursor": "editor.action.inlineDiffs.viewAllChanges"}
  ],
  "native": ["h j k l", "w b e", "0 ^ $", "f F t T", "%", "/ ? * # n N", "d c y and text objects", "v V Ctrl-v", ".", "macros", "marks", "Ctrl-o Ctrl-i", "Ctrl-d Ctrl-u", "gt gT"],
  "cursor_only_unbound": ["<leader>as"]
}
